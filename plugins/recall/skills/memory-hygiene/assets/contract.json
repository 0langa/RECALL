{
  "skill": "memory-hygiene",
  "kind": "hygiene-boundary",
  "owns": [
    "candidate routing",
    "cleanup planning",
    "safe non-destructive hygiene apply",
    "staleness and duplicate policy",
    "current-truth reconciliation planning"
  ],
  "hands_off": {
    "new durable fact capture": "save-insight",
    "focused lookup": "retrieve-memory",
    "inspection-only reports": "review-memory",
    "known-id lifecycle mutation": "manage-memory",
    "category taxonomy": "define-category",
    "hard deletion": "manage-memory delete-memory with explicit confirmation"
  },
  "safe_actions": [
    "redact_secret",
    "stale",
    "merge",
    "prune",
    "refresh_source",
    "needs_confirmation"
  ],
  "plan_version": 1,
  "review_only_actions": ["review_noise", "review_failure_history", "review_claim_conflict", "review_near_duplicate"],
  "plan_contract": {
    "identity": ["store_identity", "snapshot_identity", "plan_id"],
    "operation_identity": ["operation_id", "preconditions", "source_preconditions"],
    "limits": ["scan_limit", "output_limit", "action_limit"],
    "apply": "Exact saved operations only; changed records or sources skip without replanning.",
    "omissions": "Report unscanned records, scanned records without proposals, output and action limits, and transition conflicts."
  },
  "forbidden_without_user_confirmation": [
    "delete",
    "hard delete",
    "merge near-duplicates",
    "resolve ambiguous conflicts"
  ]
}
